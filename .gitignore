# Only curated skills and their overview are eligible for version control.
/*
!/.gitignore
!/README.md
!/LICENSE
!/.github/
/.github/*
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.yml
!/skills/
/skills/**
!/skills/**/
!/skills/**/SKILL.md
!/skills/**/references/
!/skills/**/references/*.md
# Never version source samples or acquisition records.
**/raw/**
**/private/**
**/knowledge/**
**/catalog.json
**/reviewed.json
**/progress.json
**/*.jsonl
**/*.tmp
**/__pycache__/**
**/*.pyc
